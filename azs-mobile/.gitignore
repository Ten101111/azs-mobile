# === Secrets — NEVER commit these files ===
# .env.local holds real SMTP credentials and API keys.
# The SMTP password in .env.local MUST be rotated if this file was ever committed
# to version control (check `git log --all -- .env.local`).
.env.local
.env.*.local
.env
deploy/env.production
deploy/.server

