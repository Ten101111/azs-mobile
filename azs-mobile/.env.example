VITE_YANDEX_MAPS_API_KEY=

KPI_DATA_MODE=mock
# mock = demo numbers, local = read aggregates imported by scripts/sync_kpi_metrics.py, db = direct DWH query
APP_DATA_MODE=mock
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Local aggregate import receiver. Generate a long random value and set the same
# value on the corporate machine that runs scripts/sync_kpi_metrics.py.
KPI_IMPORT_TOKEN=
# Alternative to raw token storage on the server:
# KPI_IMPORT_TOKEN_SHA256=<sha256 hex of the token>
KPI_IMPORT_URL=http://localhost:5174/api/internal/kpi/import
KPI_IMPORT_SOURCE=dwh-sync
KPI_IMPORT_MAX_RECORDS=10000
KPI_IMPORT_CHUNK_SIZE=3000

# DWH sync script settings. These are used only on the corporate machine after
# CheckPoint VPN is connected manually; the public site server does not need them.
DWH_DB_HOST=
DWH_DB_PORT=5432
DWH_DB_NAME=
DWH_DB_USER=
DWH_DB_PASSWORD=
DWH_MIN_DATE=2024-01-01
DWH_CONNECT_TIMEOUT_SECONDS=10
DWH_STATEMENT_TIMEOUT_MS=3600000
# List the exact origins your frontend will be served from.
# NEVER use * in production — it allows any site to make credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

AUTH_ALLOWED_EMAIL_DOMAINS=lukoil.com,lukoil.ru,licard.com,spb.lukoil.com,ynp.lukoil.com
AUTH_EMAIL_CODE_TTL_SECONDS=600
AUTH_EMAIL_CODE_LENGTH=6
# DEV ONLY — set to false (or omit) in production.
# When true the OTP code is returned in the API response body; never enable in production.
AUTH_EMAIL_DEV_MODE=false
# Session lifetime in seconds. Default 43200 = 12 hours.
AUTH_SESSION_TTL_SECONDS=43200
# Set to 1 only for local dev without authentication; never in production.
AUTH_DISABLED=false
# Number of trusted reverse-proxy hops in front of this server.
# 0 = no proxy, use direct client IP (safe default).
# 1 = one trusted proxy (e.g. nginx), read X-Forwarded-For rightmost untrusted IP.
# Wrong values allow IP-spoofing attacks on rate limits.
TRUSTED_PROXY_DEPTH=0
APP_PUBLIC_URL=http://localhost:5174

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Классификатор АЗС
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
