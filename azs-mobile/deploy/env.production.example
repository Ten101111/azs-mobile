APP_PUBLIC_URL=https://azs-classifier.ru
CORS_ORIGINS=https://azs-classifier.ru,https://www.azs-classifier.ru

KPI_DATA_MODE=local
APP_DATA_MODE=local
KPI_IMPORT_TOKEN=replace-with-a-long-random-token
KPI_IMPORT_MAX_RECORDS=10000

AUTH_ALLOWED_EMAIL_DOMAINS=lukoil.com,lukoil.ru,licard.com,spb.lukoil.com,ynp.lukoil.com
AUTH_EMAIL_CODE_TTL_SECONDS=600
AUTH_EMAIL_CODE_LENGTH=6
AUTH_EMAIL_DEV_MODE=false
AUTH_SESSION_TTL_SECONDS=43200
AUTH_DISABLED=false

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=no-reply@azs-classifier.ru
SMTP_FROM_NAME=Классификатор АЗС
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# nginx is the only trusted reverse proxy in the default server setup.
TRUSTED_PROXY_DEPTH=1
