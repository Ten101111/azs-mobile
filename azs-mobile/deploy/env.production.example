APP_PUBLIC_URL=https://azs-classifier.ru
CORS_ORIGINS=https://azs-classifier.ru,https://www.azs-classifier.ru

KPI_DATA_MODE=local
APP_DATA_MODE=local
KPI_IMPORT_TOKEN=replace-with-a-long-random-token
KPI_IMPORT_MAX_RECORDS=10000
FUEL_STOCK_IMPORT_TOKEN_SHA256=replace-with-sha256-of-a-separate-long-random-token
FUEL_STOCK_IMPORT_MAX_RECORDS=10000
FUEL_STOCK_IMPORT_MAX_BODY_BYTES=5242880
FUEL_STOCK_STALE_AFTER_SECONDS=5400
FUEL_STOCK_MIN_COVERAGE_RATIO=0.5
FUEL_OUTAGE_IMPORT_TOKEN=replace-with-a-separate-long-random-token
FUEL_OUTAGE_IMPORT_URL=http://127.0.0.1:8000/api/internal/fuel-outages/import
FUEL_OUTAGE_IMPORT_MAX_BODY_BYTES=10485760
FUEL_OUTAGE_STALE_AFTER_SECONDS=86400
FUEL_OUTAGE_EMAIL_FROM=Artem.Manokhin@lukoil.com
FUEL_OUTAGE_EMAIL_SUBJECT=Отчет по простоям объектов из-за отсутствия топлива
IMAP_HOST=imap.example.com
IMAP_PORT=993
# IMAP_USERNAME/IMAP_PASSWORD may be omitted when they match the SMTP credentials below.

AUTH_ALLOWED_EMAIL_DOMAINS=lukoil.com,lukoil.ru,licard.com,spb.lukoil.com,ynp.lukoil.com
AUTH_EMAIL_CODE_TTL_SECONDS=600
AUTH_EMAIL_CODE_LENGTH=6
AUTH_EMAIL_DEV_MODE=false
AUTH_SESSION_TTL_SECONDS=43200
AUTH_DISABLED=false

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=no-reply@azs-classifier.ru
SMTP_FROM_NAME=Классификатор АЗС
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# nginx is the only trusted reverse proxy in the default server setup.
TRUSTED_PROXY_DEPTH=1
